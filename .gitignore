# Public source allowlist. Runtime data, credentials and local bridges stay out.
*
!/.gitignore
!/.env.example
!/README.md
!/COMANDOS.md
!/AGENTS.md
!/CLAUDE.md
!/LICENSE
!/NOTICE
!/package.json
!/package-lock.json
!/requirements.txt
!/src/
!/src/**
!/web/
!/web/**
!/integrations/
!/integrations/**
!/scripts/
!/scripts/**
!/tests/
!/tests/**
!/docs/
!/docs/**
!/estudos/
!/estudos/*.md
!/site-src/
!/site-src/**
!/.github/
!/.github/**
.env.local
data/
local-ai/
site/
node_modules/
.venv/
__pycache__/
*.log
*.enc
*.sqlite*
*.db
*.key
*.pem
*.zip
